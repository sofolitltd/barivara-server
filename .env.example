BULKSMSBD_API_KEY=your_api_key_here
BULKSMSBD_SENDER_ID=your_sender_id_here
JWT_SECRET=a_long_random_secret
PORT=8080

# Optional — admin notification when a landlord request is submitted.
# Leave unset to disable (logs a warning at startup, no-op at runtime).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional — FCM push to the Android app (e.g. landlord-approval ping).
# Full JSON contents of a Firebase service account key (Firebase console
# > Project settings > Service accounts > Generate new private key), as
# a single-line value. Leave unset to disable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# from `neon env pull` (see README)
DATABASE_URL=postgres://user:pass@host/db
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
OBJECT_STORAGE_BUCKET=uploads
